{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AgentOffice",
  "version": "0.1.0",
  "identifier": "com.agentoffice.app",
  "build": {
    "frontendDist": "../dist/claw-garden/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "bun run start",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "AgentOffice",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
