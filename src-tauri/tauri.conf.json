{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Claw Garden",
  "version": "0.1.0",
  "identifier": "com.clawgarden.app",
  "build": {
    "frontendDist": "../dist/clawg-desktop/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "bun run start",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "Claw Garden",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
